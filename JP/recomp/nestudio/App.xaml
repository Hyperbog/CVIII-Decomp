<Application x:Class="NEStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#111722"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#192333"/>
    <SolidColorBrush x:Key="DarkPanelBrush" Color="#141D2A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5AABDB"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#DDE5EF"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#26384D"/>
      <Setter Property="Foreground" Value="#EDF5FC"/>
      <Setter Property="BorderBrush" Value="#3E546A"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F1825"/>
      <Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#3E5369"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#25354A"/>
      <Setter Property="Foreground" Value="#111722"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#141D2A"/>
      <Setter Property="Foreground" Value="#E3EBF5"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="#141D2A"/>
      <Setter Property="Foreground" Value="#DFE8F2"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#192333"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="Foreground" Value="#E3EBF5"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#DDE5EF"/>
      <Setter Property="Background" Value="#26384D"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Application.Resources>
</Application>
