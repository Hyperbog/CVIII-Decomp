<Window x:Class="NEStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="NEStudio — Enhanced NES Development Environment"
        Width="1600" Height="970" MinWidth="1140" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#111722"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#101925" BorderBrush="#324258" BorderThickness="0,0,0,1" Padding="12,9">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="NE" Foreground="#62BCE8" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="Studio" FontSize="21" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
          <Button Content="New Project" Click="NewProject_Click"/>
          <Button Content="Open" Click="OpenProject_Click"/>
          <Button Content="Save" Click="SaveProject_Click"/>
          <Button Content="Save As" Click="SaveAs_Click"/>
          <Button Content="Set Game / Launcher" Click="ChooseGame_Click"/>
          <Button Content="Acceptance Log" Click="OpenAcceptanceLog_Click" ToolTip="Open the user-local Windows viewport and bridge acceptance log"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Run / Attach" Click="Run_Click" Background="#235D56"/>
          <Button Content="Edit / Pause" Click="Pause_Click"/>
          <Button Content="Play" Click="Play_Click"/>
          <Button Content="Focus Game" Click="FocusGame_Click" ToolTip="Give keyboard input to the embedded SDL game window"/>
          <Button Content="Stop" Click="Stop_Click" Background="#623B48"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#162335" BorderBrush="#304056" BorderThickness="0,0,0,1" Padding="13,5">
      <DockPanel>
        <TextBlock Text="PROJECT" Foreground="#7D9DB6" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="ProjectLabel" Text="Untitled Project" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="  /  SCENE" Foreground="#7D9DB6" FontSize="10" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <TextBlock x:Name="RoomLabel" Text="No active scene" VerticalAlignment="Center" FontSize="12"/>
        <TextBlock x:Name="ConnectionLabel" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Foreground="#ACBDCE"
                   VerticalAlignment="Center" Text="OFFLINE · Game not started"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" Margin="10,10,10,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" MinWidth="175"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="450"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="340" MinWidth="270"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#192333" CornerRadius="6" BorderBrush="#324358" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
            <TextBlock Text="SCENE OUTLINER" FontWeight="SemiBold" Foreground="#ACD7F3" FontSize="12"/>
            <TextBlock Text="Live game lights and authored project layers" FontSize="10" Foreground="#8FA4B9" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <TreeView x:Name="SceneTree" Margin="8" SelectedItemChanged="SceneTree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="320"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="195" MinHeight="120"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="6" BorderBrush="#324358" BorderThickness="1" Background="#0C1119">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#192333" BorderBrush="#324358" BorderThickness="0,0,0,1" Padding="9,8">
              <DockPanel>
                <TextBlock Text="GAME VIEWPORT" FontWeight="SemiBold" FontSize="12" Foreground="#A7D9F7"/>
                <TextBlock Text="256 × 240 NES · Native SDL2 recomp" Foreground="#8AA2BA" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
              </DockPanel>
            </Border>
            <Grid Background="#090D13">
              <wfi:WindowsFormsHost x:Name="ViewportHost" Margin="8"/>
              <TextBlock x:Name="ViewportHint" Text="Start the native Enhanced game with Run / Attach.&#10;The running SDL2 window will be embedded here."
                         TextAlignment="Center" VerticalAlignment="Center"
                         HorizontalAlignment="Center" Foreground="#8DA9BD"
                         IsHitTestVisible="False" FontSize="15"/>
            </Grid>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border Grid.Row="2" Background="#192333" CornerRadius="6" BorderBrush="#324358" BorderThickness="1">
          <TabControl>
            <TabItem Header="Timeline">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="EVENT TRACKS" Foreground="#A5BDD4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Content="+ Event" Click="NewEvent_Click" Margin="10,0,2,0"/>
                  <TextBlock Text="Authoring timeline (not wired to gameplay triggers yet)" Foreground="#8A9BAA" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="TimelineList" Grid.Row="1" Margin="0,8,0,0"/>
              </Grid>
            </TabItem>
            <TabItem Header="Console">
              <TextBox x:Name="ConsoleText" IsReadOnly="True" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Background="#101720" FontFamily="Consolas" FontSize="11"
                       BorderThickness="0"/>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="4" Background="#192333" CornerRadius="6" BorderBrush="#324358" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,10,12,5">
            <TextBlock Text="INSPECTOR" FontWeight="SemiBold" FontSize="12" Foreground="#ACD7F3"/>
            <TextBlock x:Name="SelectionLabel" Text="Select an object in the scene tree" TextWrapping="Wrap"
                       Foreground="#9AAEC1" FontSize="11" Margin="0,5,0,0"/>
          </StackPanel>
          <TabControl Margin="6,0,6,8">
            <TabItem Header="Lighting">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8,10,12">
                  <TextBlock Text="LIVE LIGHTING" Foreground="#B0DCF2" FontWeight="Bold" Margin="0,0,0,7"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="+ Candle" Click="Candle_Click"/>
                    <Button Content="+ Torch" Click="Torch_Click"/>
                    <Button Content="Duplicate" Click="Duplicate_Click"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Delete" Click="DeleteLight_Click"/>
                    <Button Content="Undo" Click="Undo_Click"/>
                    <Button Content="Redo" Click="Redo_Click"/>
                  </StackPanel>
                  <TextBlock Text="Selected Light" FontWeight="SemiBold" Margin="0,8,0,4"/>
                  <TextBlock x:Name="LightName" Text="No light selected" Foreground="#99D9FF" TextWrapping="Wrap"/>
                  <TextBlock Text="Radius" Margin="0,11,0,0"/>
                  <Slider x:Name="LightRadius" Minimum="12" Maximum="160" Tag="2" ValueChanged="LightSlider_Changed"/>
                  <TextBlock Text="Intensity" Margin="0,9,0,0"/>
                  <Slider x:Name="LightPower" Minimum="5" Maximum="160" Tag="3" ValueChanged="LightSlider_Changed"/>
                  <TextBlock Text="Red" Margin="0,9,0,0"/>
                  <Slider x:Name="LightRed" Minimum="0" Maximum="255" Tag="4" ValueChanged="LightSlider_Changed"/>
                  <TextBlock Text="Green" Margin="0,9,0,0"/>
                  <Slider x:Name="LightGreen" Minimum="0" Maximum="255" Tag="5" ValueChanged="LightSlider_Changed"/>
                  <TextBlock Text="Blue" Margin="0,9,0,0"/>
                  <Slider x:Name="LightBlue" Minimum="0" Maximum="255" Tag="6" ValueChanged="LightSlider_Changed"/>
                  <TextBlock Text="Flicker" Margin="0,10,0,0"/>
                  <ComboBox x:Name="FlickerCombo" SelectionChanged="FlickerCombo_Changed">
                    <ComboBoxItem Content="Candle"/>
                    <ComboBoxItem Content="Steady"/>
                    <ComboBoxItem Content="Torch"/>
                    <ComboBoxItem Content="Soft Pulse"/>
                    <ComboBoxItem Content="Ember Dips"/>
                  </ComboBox>
                  <Separator Margin="0,15"/>
                  <TextBlock Text="RENDERER" Foreground="#B0DCF2" FontWeight="Bold"/>
                  <ComboBox x:Name="RendererCombo" Margin="0,8" SelectionChanged="RendererCombo_Changed">
                    <ComboBoxItem Content="Standard CPU"/>
                    <ComboBoxItem Content="GPU One-Bounce"/>
                    <ComboBoxItem Content="Radiance Cascades"/>
                  </ComboBox>
                  <TextBlock Text="Native game is authoritative for live lighting. Other authoring panels save versioned NEStudio project assets." FontSize="11" Foreground="#95A8BB" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Sprites">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8">
                  <TextBlock Text="LIVE PPU SPRITES" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <TextBlock Text="Actual OAM slots (read-only; original rotation changes slot identity)" Foreground="#94AABE" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <ListBox x:Name="LiveSpritesList" Height="135" Margin="0,8"/>
                  <Separator Margin="0,12"/>
                  <TextBlock Text="SPRITE LAYER GROUPS" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <ListBox x:Name="SpriteList" Height="155" Margin="0,8" SelectionChanged="SpriteList_SelectionChanged"/>
                  <TextBlock Text="Group Name" Margin="0,8,0,0"/>
                  <TextBox x:Name="SpriteName" TextChanged="SpriteName_Changed"/>
                  <TextBlock Text="Sorting Layer" Margin="0,8,0,0"/>
                  <ComboBox x:Name="SpriteLayerCombo" SelectionChanged="SpriteLayer_Changed">
                    <ComboBoxItem Content="Behind Game"/>
                    <ComboBoxItem Content="World"/>
                    <ComboBoxItem Content="Above Game"/>
                    <ComboBoxItem Content="UI"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Group" Click="AddSpriteGroup_Click"/>
                    <Button Content="Remove" Click="RemoveSpriteGroup_Click"/>
                  </StackPanel>
                  <TextBlock Text="Groups are now project assets. Runtime sprite replacement and OAM source mapping require the next integration pass." Foreground="#9AAFC1" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Dialogue">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8">
                  <TextBlock Text="DIALOGUE &amp; TRANSLATIONS" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <ListBox x:Name="DialogueList" Height="120" Margin="0,8" SelectionChanged="DialogueList_SelectionChanged"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="+ Dialogue" Click="AddDialogue_Click"/>
                    <Button Content="Remove" Click="RemoveDialogue_Click"/>
                  </StackPanel>
                  <TextBlock Text="Event Identifier" Margin="0,9,0,0"/>
                  <TextBox x:Name="DialogueId" TextChanged="Dialogue_Changed"/>
                  <TextBlock Text="Language" Margin="0,8,0,0"/>
                  <ComboBox x:Name="LanguageCombo" SelectionChanged="Language_Changed">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Japanese" Tag="ja"/>
                    <ComboBoxItem Content="French" Tag="fr"/>
                    <ComboBoxItem Content="Spanish" Tag="es"/>
                    <ComboBoxItem Content="German" Tag="de"/>
                  </ComboBox>
                  <TextBlock Text="Text (new lines preserved; use [page] for manual page)" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  <TextBox x:Name="DialogueText" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" Height="122" TextChanged="Dialogue_Changed"/>
                  <StackPanel Orientation="Horizontal" Margin="0,9">
                    <TextBlock Text="Max characters/line" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox x:Name="DialogueWrap" Width="47" Margin="8,0" TextChanged="Dialogue_Changed"/>
                  </StackPanel>
                  <TextBlock Text="LIVE LAYOUT PREVIEW" FontWeight="Bold" Foreground="#B0DCF2" Margin="0,12,0,5"/>
                  <Border Background="#111827" BorderBrush="#4E6378" BorderThickness="2" Padding="12" MinHeight="70">
                    <TextBlock x:Name="DialoguePreview" TextWrapping="Wrap" Foreground="#FAFCFF" FontFamily="Consolas" FontSize="12"/>
                  </Border>
                  <TextBlock Text="Dialogue records and translations persist in the project. Original-script hook integration is not yet enabled." Foreground="#9AAFC1" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Assets">
              <StackPanel Margin="10">
                <TextBlock Text="PROJECT ASSETS" Foreground="#B0DCF2" FontWeight="Bold"/>
                <Button Content="+ Reference Asset" Click="AddAsset_Click" HorizontalAlignment="Left" Margin="0,9"/>
                <ListBox x:Name="AssetList" Margin="0,5" Height="260"/>
                <TextBlock Text="Assets are referenced, not copied into the repository. Original ROM-derived assets remain private." FontSize="11" Foreground="#9AAFC1" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#0E1724" BorderBrush="#304056" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready — New project" Foreground="#A5BED0" FontSize="11"/>
        <TextBlock DockPanel.Dock="Right" Text="NEStudio Foundation · Project schema v1" Foreground="#738DA4" FontSize="10"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
