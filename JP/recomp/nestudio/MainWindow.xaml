<Window x:Class="NEStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:local="clr-namespace:NEStudio"
        Title="NEStudio — Enhanced NES Development Environment"
        Width="1600" Height="970" MinWidth="1140" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0B0D11" Focusable="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Project actions + transport are distinct from the tool workspaces. -->
    <Border Grid.Row="0" Background="#141B25" BorderBrush="#2F4050"
            BorderThickness="0,0,0,1" Padding="15,6">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="NE" Foreground="#7BD7F4" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Foreground="#F1F5F9" FontSize="18" FontWeight="SemiBold"
                     Margin="2,0,17,0" VerticalAlignment="Center"/>
          <Border Background="#223344" Padding="8,3" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock Text="LIVE MODIFICATION" Foreground="#A7C6DB" FontSize="10" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="New" ToolTip="New local authoring project" Click="NewProject_Click"/>
          <Button Content="Open" ToolTip="Open .nestudio project (Ctrl+O)" Click="OpenProject_Click"/>
          <Button Content="Save" ToolTip="Save project and native effects (Ctrl+S)" Click="SaveProject_Click"/>
          <Button Content="Game..." ToolTip="Choose your privately compiled game executable" Click="ChooseGame_Click"/>
          <Button Content="Attach" Click="Run_Click" Background="#226655"
                  ToolTip="Launch privately compiled Enhanced game and attach SDL viewport"/>
          <Button Content="Edit" Click="Pause_Click" ToolTip="Pause runtime and activate viewport editing"/>
          <Button Content="Play" Click="Play_Click" ToolTip="Resume runtime with keyboard capture"/>
          <Button x:Name="GameInputButton" Content="Keys" Click="FocusGame_Click"
                  ToolTip="Capture controller keys; Escape releases input"/>
          <Button Content="Stop" Click="Stop_Click" Background="#543440" ToolTip="Stop only the attached native game"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Modes change which live object the viewport selects and which inspector appears. -->
    <Border Grid.Row="1" Background="#111821" BorderBrush="#2F4050"
            BorderThickness="0,0,0,1" Padding="13,5">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="WorkspaceLighting" Content="Lighting" Tag="lighting" Click="Workspace_Click"
                  ToolTip="Ctrl+1 · live lighting and pixel FX" Padding="15,6"/>
          <Button x:Name="WorkspaceSprites" Content="Sprites / Objects" Tag="sprites" Click="Workspace_Click"
                  ToolTip="Ctrl+2 · native sprite picker and stable original objects" Padding="15,6"/>
          <Button x:Name="WorkspaceDialogue" Content="Dialogue" Tag="dialogue" Click="Workspace_Click"
                  ToolTip="Ctrl+3 · text events, safe offline preview and region picking" Padding="15,6"/>
          <Button x:Name="WorkspaceAssets" Content="References" Tag="assets" Click="Workspace_Click"
                  ToolTip="Owner-local references, not ROM assets" Padding="15,6"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FocusLayoutButton" Content="Focus View" Click="FocusLayout_Click"
                  ToolTip="F11 · hide docks and concentrate on live game preview"/>
          <Button Content="Console" Tag="console" Click="BottomDrawer_Click"
                  ToolTip="Show or hide diagnostics; Ctrl+`"/>
          <Button Content="Events" Tag="events" Click="BottomDrawer_Click"
                  ToolTip="Open authored event timeline"/>
          <Button Content="Log" Click="OpenAcceptanceLog_Click"
                  ToolTip="Open live Windows acceptance log"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
          <TextBlock x:Name="ProjectLabel" Text="Untitled Project" FontSize="11" VerticalAlignment="Center"
                     Foreground="#CBD9E6"/>
          <TextBlock Text="  /  " VerticalAlignment="Center" Foreground="#7891A4"/>
          <TextBlock x:Name="RoomLabel" Text="No active room" FontSize="11" VerticalAlignment="Center"
                     Foreground="#99BBD1"/>
          <TextBlock x:Name="ConnectionLabel" Text=" · OFFLINE" Foreground="#D6C28A"
                     FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" Margin="10,10,10,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="OutlinerColumn" Width="240"/>
        <ColumnDefinition x:Name="OutlinerSplitterColumn" Width="6"/>
        <ColumnDefinition Width="*" MinWidth="430"/>
        <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="390"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="OutlinerPanel" Grid.Column="0" Background="#141D27" CornerRadius="5"
              BorderBrush="#304558" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="11,10,11,4">
            <DockPanel>
              <TextBlock Text="SCENE OUTLINER" FontSize="11" FontWeight="Bold" Foreground="#9BBAD0"
                         VerticalAlignment="Center"/>
              <Button Content="+ Add" DockPanel.Dock="Right" Padding="8,3"
                      Click="QuickAdd_Click"
                      ToolTip="Create an object appropriate for the active workspace"/>
            </DockPanel>
            <TextBox x:Name="SceneSearch" Margin="0,8,0,0"
                     ToolTip="Filter lights, dialogue, groups and reference nodes (Ctrl+F)"
                     TextChanged="SceneSearch_Changed"/>
            <TextBlock x:Name="SceneCountLabel" Text="Waiting for live scene"
                       Foreground="#899EB2" FontSize="11" Margin="0,5,0,2"/>
          </StackPanel>
          <TreeView x:Name="SceneTree" Margin="7" SelectedItemChanged="SceneTree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="OutlinerSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="300"/>
          <RowDefinition Height="6"/>
          <RowDefinition x:Name="BottomRow" Height="0"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="6" BorderBrush="#3A5063" BorderThickness="1" Background="#080C11">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#151F2B"
                    BorderBrush="#304558" BorderThickness="0,0,0,1" Padding="11,7">
              <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <TextBlock Text="LIVE VIEW" FontWeight="Bold" Foreground="#D8EDF8"
                             FontSize="12" VerticalAlignment="Center" Margin="0,0,13,0"/>
                  <TextBlock x:Name="ViewportToolLabel" Text="SELECT · Lighting" Foreground="#80CBEF"
                             FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="256 × 240  ·  Native SDL"
                           Foreground="#94AABC" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
              </DockPanel>
            </Border>
            <Grid Background="#070A0F">
              <wfi:WindowsFormsHost x:Name="ViewportHost" Margin="6"/>
              <TextBlock x:Name="ViewportHint" Text="Click Run / Attach to launch the private Enhanced EXE directly.&#10;The native SDL viewport will appear here after the session handshake."
                         TextAlignment="Center" VerticalAlignment="Center"
                         HorizontalAlignment="Center" Foreground="#D6E4F0"
                         IsHitTestVisible="False" FontSize="15"/>
            </Grid>
          </DockPanel>
        </Border>
        <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Height="6" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border x:Name="BottomPanel" Grid.Row="2" Visibility="Collapsed" Background="#141A22" CornerRadius="6" BorderBrush="#3A5063" BorderThickness="1">
          <TabControl x:Name="BottomTabs">
            <TabItem Header="Events">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="EVENT TRACKS" Foreground="#A5BDD4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Content="+ Event" Click="NewEvent_Click" Margin="10,0,2,0"/>
                  <TextBlock Text="Authoring timeline (not wired to gameplay triggers yet)" Foreground="#C6D5E3" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="TimelineList" Grid.Row="1" Margin="0,8,0,0"/>
              </Grid>
            </TabItem>
            <TabItem Header="Console">
              <TextBox x:Name="ConsoleText" IsReadOnly="True" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Background="#0C1017" FontFamily="Consolas" FontSize="11"
                       BorderThickness="0"/>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border x:Name="InspectorPanel" Grid.Column="4" Background="#141D27" CornerRadius="5"
              BorderBrush="#304558" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,10,12,7">
            <TextBlock x:Name="InspectorTitle" Text="LIGHTING · DETAILS"
                       FontWeight="Bold" FontSize="12" Foreground="#A4D9F6"/>
            <TextBlock x:Name="SelectionLabel" Text="Select something in the viewport or outliner"
                       TextWrapping="Wrap" Foreground="#BFCFDE" FontSize="11" Margin="0,5,0,0"/>
          </StackPanel>
          <!-- Workspace header buttons are the only top-level mode tabs. -->
          <TabControl x:Name="InspectorTabs" Margin="3,0,3,5" SelectionChanged="InspectorTabs_SelectionChanged">
            <TabControl.Template>
              <ControlTemplate TargetType="{x:Type TabControl}">
                <Border Background="#111923" BorderBrush="#324657" BorderThickness="0">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </Border>
              </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="LightingTab" Header="Lighting">
              <local:LightingWorkbench x:Name="LightingStudio"/>
            </TabItem>
            <TabItem x:Name="SpritesTab" Header="Sprites">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8">
                  <TextBlock Text="ORIGINAL GAME OBJECTS (28-slot CPU table)" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <TextBlock Text="True game object index and active-lifetime generation, not a rotating PPU sprite slot. Ctrl-click to select multiple."
                             Foreground="#CAD9E7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <TextBlock x:Name="SpriteSourceStatus" Text="Original source OAM ownership: waiting for native frames"
                             Foreground="#F6D18B" TextWrapping="Wrap" Margin="0,5,0,2"/>
                  <ListBox x:Name="OriginalObjectsList" Height="142" Margin="0,8"
                           SelectionMode="Extended" DisplayMemberPath="Label"
                           SelectionChanged="OriginalObjects_SelectionChanged"/>
                  <Button Content="Group Original Objects (Ctrl+G)" Click="GroupOriginalObjects_Click"/>
                  <Separator Margin="0,12"/>
                  <TextBlock Text="LIVE PPU SPRITES — emission-index decoded" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <TextBlock Text="Actual OAM slots (read-only; original rotation changes slot identity)" Foreground="#CAD9E7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <TextBlock Text="Click a sprite in the paused viewport. Ctrl/Shift+click to multiselect; Ctrl+G groups OAM snapshots."
                             Foreground="#E1F1FA" TextWrapping="Wrap" Margin="0,5,0,4"/>
                  <ListBox x:Name="LiveSpritesList" Height="135" Margin="0,8"
                           SelectionMode="Extended" DisplayMemberPath="Label" SelectionChanged="LiveSprites_SelectionChanged"/>
                  <Button Content="Group Selected Sprites (Ctrl+G)" Click="GroupSelectedSprites_Click"/>
                  <Separator Margin="0,12"/>
                  <TextBlock Text="SPRITE LAYER GROUPS" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <ListBox x:Name="SpriteList" Height="155" Margin="0,8" SelectionChanged="SpriteList_SelectionChanged"/>
                  <TextBlock Text="Group Name" Margin="0,8,0,0"/>
                  <TextBox x:Name="SpriteName" TextChanged="SpriteName_Changed"/>
                  <TextBlock Text="Sorting Layer" Margin="0,8,0,0"/>
                  <ComboBox x:Name="SpriteLayerCombo" SelectionChanged="SpriteLayer_Changed">
                    <ComboBoxItem Content="Behind Game"/>
                    <ComboBoxItem Content="World"/>
                    <ComboBoxItem Content="Above Game"/>
                    <ComboBoxItem Content="UI"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Group" Click="AddSpriteGroup_Click"/>
                    <Button Content="Remove" Click="RemoveSpriteGroup_Click"/>
                  </StackPanel>
                  <TextBlock Text="Exact source-observed sprite owners highlight in gold; manually chosen sprite slots highlight in cyan. Any frame with missing or inconsistent PRG26 source evidence stays unattributed." Foreground="#CAD9E7" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DialogueTab" Header="Dialogue">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8">
                  <TextBlock Text="DIALOGUE &amp; TRANSLATIONS" FontWeight="Bold" Foreground="#B0DCF2"/>
                  <TextBlock Text="Authentic raw0A:$B8FF calls to fixed $EC47 are validated against the original stack, bank switch and $E62D return. Formatter events can trigger authored entries. The $0300 commands and later PPU writes are observed without assuming that every byte is a glyph."
                             Foreground="#CDD9E6" TextWrapping="Wrap" Margin="0,3,0,8"/>
                  <Button Content="Bind selected original actor script" Click="BindActorScript_Click"/>
                  <Button Content="Bind verified $EC47 formatter call" Click="BindFormatter_Click"
                          ToolTip="Requires authenticated B8FF to EC47 to bank00:966A path and completed E62D bank return."/>
                  <Button Content="Bind last original room-message byte" Click="BindRoomMessage_Click"
                          ToolTip="Source event at JP raw0A:B8F4; original JSR $EC47 follows nonterminal bytes."/>
                  <TextBlock x:Name="OriginalScriptStatus" Text="Original dialogue-printer hook: unavailable"
                             Foreground="#B6CFE4" TextWrapping="Wrap" Margin="0,3,0,8"/>
                  <TextBlock x:Name="GlyphDecodeStatus" Text="Original $0300 tile decoder: waiting for verified command data"
                             Foreground="#BFE8D7" TextWrapping="Wrap" Margin="0,4,0,6"/>
                  <Button Content="Validate Replacement Draft (offline only)" Click="ValidateReplacement_Click"
                          ToolTip="Preserve original VRAM rows and byte counts; no changes to ROM, guest memory, PPU or live text."/>
                  <TextBlock x:Name="ReplacementSafetyStatus" Text="Live text replacement is disabled. Only validated source hashes and draft previews are saved."
                             Foreground="#F6D18B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                  <TextBlock x:Name="FormatterStatus" Text="Original $EC47 formatter: no authenticated call yet"
                             Foreground="#D7E9F3" TextWrapping="Wrap" Margin="0,4,0,6"/>
                  <TextBlock x:Name="PpuSourceStatus" Text="Original PPU nametable-write source recorder: waiting for game"
                             Foreground="#F6D18B" TextWrapping="Wrap" Margin="0,4,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                    <Button Content="Bind region: click viewport" Click="BindDialogueRegion_Click"/>
                    <Button Content="Clear region" Click="ClearDialogueRegion_Click"/>
                  </StackPanel>
                  <TextBlock Text="Bound authored regions highlight amber and can be selected by clicking the viewport. Automatic recognition of original script triggers is not implemented."
                             Foreground="#CDD9E6" TextWrapping="Wrap" Margin="0,3,0,7"/>
                  <ListBox x:Name="DialogueList" Height="120" Margin="0,8" SelectionChanged="DialogueList_SelectionChanged"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="+ Dialogue" Click="AddDialogue_Click"/>
                    <Button Content="Remove" Click="RemoveDialogue_Click"/>
                  </StackPanel>
                  <TextBlock Text="Event Identifier" Margin="0,9,0,0"/>
                  <TextBox x:Name="DialogueId" TextChanged="Dialogue_Changed"/>
                  <TextBlock Text="Language" Margin="0,8,0,0"/>
                  <ComboBox x:Name="LanguageCombo" SelectionChanged="Language_Changed">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Japanese" Tag="ja"/>
                    <ComboBoxItem Content="French" Tag="fr"/>
                    <ComboBoxItem Content="Spanish" Tag="es"/>
                    <ComboBoxItem Content="German" Tag="de"/>
                  </ComboBox>
                  <TextBlock Text="Text (new lines preserved; use [page] for manual page)" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  <TextBox x:Name="DialogueText" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" Height="122" TextChanged="Dialogue_Changed"/>
                  <StackPanel Orientation="Horizontal" Margin="0,9">
                    <TextBlock Text="Max characters/line" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox x:Name="DialogueWrap" Width="47" Margin="8,0" TextChanged="Dialogue_Changed"/>
                  </StackPanel>
                  <TextBlock Text="LIVE LAYOUT PREVIEW" FontWeight="Bold" Foreground="#B0DCF2" Margin="0,12,0,5"/>
                  <Border Background="#0C111A" BorderBrush="#4E6378" BorderThickness="2" Padding="12" MinHeight="70">
                    <TextBlock x:Name="DialoguePreview" TextWrapping="Wrap" Foreground="#FAFCFF" FontFamily="Consolas" FontSize="12"/>
                  </Border>
                  <TextBlock Text="Dialogue records and translations persist in the project. Original-script hook integration is not yet enabled." Foreground="#CAD9E7" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Assets">
              <StackPanel Margin="10">
                <TextBlock Text="PROJECT ASSETS" Foreground="#B0DCF2" FontWeight="Bold"/>
                <Button Content="+ Reference Asset" Click="AddAsset_Click" HorizontalAlignment="Left" Margin="0,9"/>
                <ListBox x:Name="AssetList" Margin="0,5" Height="260"/>
                <TextBlock Text="Assets are referenced, not copied into the repository. Original ROM-derived assets remain private." FontSize="11" Foreground="#CAD9E7" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#101720" BorderBrush="#35485A"
            BorderThickness="0,1,0,0" Padding="13,7">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready · Open a project or attach a game"
                   Foreground="#D6E2EC" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" Text="Ctrl+1/2/3  Workspaces    Ctrl+F  Find    F11  Focus    Ctrl+S  Save"
                   Foreground="#899FB1" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
