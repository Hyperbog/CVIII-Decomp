# Commercial cartridges, private native states and generated ROM asset cache.
# Keep all owner-ROM-derived binary media out of public source/CI.
*.nes
*.nsf
*.cycstate
CVIII-Assets.bin

# Owner-local asset index and gameplay instrumentation
CVIII-CHR-Index.dat
CVIII-CHR-Audit.csv
CVIII-CHR-Fetch.csv
CVIII-CHR-Fetch.json

# JP0601 owner-local synchronized PPU frame evidence
CVIII-Frame-Evidence.csv
CVIII-Frame-Evidence.json

# JP0602 private live scene QA captures and summary (not distributable)
QA/
CVIII-QA-Matrix.json

# JP0661 private native keyboard/control profiles and host config.
# Never accidentally publish the user's bindings or automatic config backups.
**/AlphaCandidate/config.ini
**/AlphaCandidate/control-profiles/
**/AlphaCandidate/control-backups/
JP/recomp/release/alpha/config.ini
JP/recomp/release/alpha/control-profiles/
JP/recomp/release/alpha/control-backups/

# Generated Python caches are never source artifacts.
__pycache__/
*.py[cod]

# Build products, intermediate compilers and owner-local candidates.
# Preserve tracked sources; these patterns only prevent accidental new media.
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/_private_original_rom_build/
**/_external/
**/_external_nesrecomp/
**/AlphaCandidate/
**/ProductCandidate*/
**/build/
**/dist/
**/out/
*.obj
*.o
*.pdb
*.ilk
*.exe
*.dll
CVIII-Alpha-*-PRIVATE.zip
CVIII-DMC-DMA.csv
Mesen-DMC-DMA.csv
Controller-Host.txt
PRODUCT_CANDIDATE.json
